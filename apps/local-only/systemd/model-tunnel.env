# Copied to ~/.config/cline-local/tunnel.env by the model-tunnel user unit.
#
# The tunnel forwards the model port to the same port on loopback, so in the
# plugin settings the endpoint becomes http://127.0.0.1:8080/v1 and the
# plaintext-LAN option stays off. If that port is already taken on this machine,
# change TUNNEL_PORT to a free one and use it in the settings URL too.

TUNNEL_TARGET=thomas@192.168.0.33
TUNNEL_PORT=8080
